<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Pokemon3D</AssemblyName>
    <RootNamespace>P3D</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.2.1105" />
    <!-- Cross-platform clipboard support (replaces System.Windows.Forms Clipboard) -->
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

  <!-- Phase 11: compile fonts, shaders, and 3D models via MGCB -->
  <ItemGroup>
    <MonoGameContentReference Include="..\lib\P3D.ContentPipeline\Content\Content.mgcb" />
  </ItemGroup>

  <!--
    Copy the shared game content (raw PNG/OGG/dat/poke/etc.) from the original
    project's Content directory to this project's output directory at build time.
    No MGCB compilation is needed for these files — they are loaded at runtime
    as raw streams by TextureManager / SoundManager.
  -->
  <ItemGroup>
    <Content Include="..\P3D\Content\**\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="Content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
