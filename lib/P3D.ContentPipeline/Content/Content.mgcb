
#----------------------------- Global Properties ----------------------------#

/outputDir:bin
/intermediateDir:obj
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

/reference:../../../lib/P3D.FontPipeline/bin/Release/net8.0/P3D.FontPipeline.dll

#---------------------------------- Content ---------------------------------#

# Effects: pre-compiled XNBs committed; recompile with Wine+d3dcompiler_47 if source changes
#   MGFXC_WINE_PATH=~/.wine dotnet mgcb /platform:DesktopGL /importer:EffectImporter /processor:EffectProcessor /build:Effects/BackdropShader.fx /build:Effects/GaussianBlur.fx

#begin Effects/BackdropShader.xnb
/copy:Effects/BackdropShader.xnb

#begin Effects/GaussianBlur.xnb
/copy:Effects/GaussianBlur.xnb

#begin Fonts/BMP/Braille.png
/importer:TextureImporter
/processor:FontTextureProcessor
/processorParam:FirstCharacter=
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:Fonts/BMP/Braille.png

#begin Fonts/BMP/chatFont.png
/importer:LocalizedFontTextureImporter
/processor:LocalizedFontTextureProcessor
/processorParam:DefaultCharacter=?
/processorParam:FirstCharacter=
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:Fonts/BMP/chatFont.png

#begin Fonts/BMP/GameJolt.xnb
