<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>P3D.ContentPipeline</AssemblyName>
    <RootNamespace>P3D.ContentPipeline</RootNamespace>
    <!--
      This project contains no C# source — it is a container for the MonoGame
      content pipeline source assets (shaders, 3D models, BMP fonts, the MGCB
      descriptor).  The actual XNB compilation is driven by the
      <MonoGameContentReference> item in each game project, not by this csproj.
      netstandard2.0 is compatible with both .NET Framework 4.5+ (original VB
      project) and .NET 5+ / .NET 10 (C# port).
    -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="Content\**\*" />
  </ItemGroup>

</Project>
